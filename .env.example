# ==============================================================================
# Sovereign Supply Chain Multi-Agent System (MAS) - Environment Configuration
# ==============================================================================

# LLM Provider Configuration
# Choose your preferred provider (OpenAI, Anthropic, Ollama, Groq, etc.)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL_NAME=gpt-4o-mini

# Execution Mode:
# Set to 'mock' to run the system with intelligent deterministic reasoning (no API keys required)
# Set to 'live' to run with real LLM provider
LLM_MODE=mock

# State / Sovereign Reserve Thresholds (Default values in units)
STRATEGIC_RESERVE_THRESHOLD=500
MAX_EMERGENCY_BUDGET_EUR=100000

# LangSmith Tracing (Optional)
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=your_langchain_api_key_here
LANGCHAIN_PROJECT=multi-agent-supply-chain-system

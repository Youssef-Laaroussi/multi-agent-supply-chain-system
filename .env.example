# ==============================================================================
# Sovereign Supply Chain Multi-Agent System (MAS) - Environment Configuration
# ==============================================================================

# Execution Mode:
# Set to 'mock' to run the system with intelligent deterministic reasoning (no API keys required)
# Set to 'live' to run with real LLM provider (DeepSeek or OpenAI) - REQUIRED FOR LIVE WEB DASHBOARD
LLM_MODE=mock

# Provider selection: 'auto', 'deepseek', or 'openai'
# If you want to use the web dashboard with live LLMs, change LLM_MODE=live and provide a key below.
LLM_PROVIDER=auto

# ------------------------------------------------------------------------------
# 1. DeepSeek API Configuration (OpenAI Compatible)
# ------------------------------------------------------------------------------
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_MODEL_NAME=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com

# ------------------------------------------------------------------------------
# 2. OpenAI API Configuration
# ------------------------------------------------------------------------------
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL_NAME=gpt-4o-mini

# ------------------------------------------------------------------------------
# 3. LangGraph Checkpointing & Persistence
# ------------------------------------------------------------------------------
# Backend: 'memory' (ephemeral) or 'sqlite' (persistent SQLite database)
CHECKPOINTER_BACKEND=memory
SQLITE_CHECKPOINT_PATH=reports/checkpoints.db

# ------------------------------------------------------------------------------
# 4. LangSmith Observability & Tracing
# ------------------------------------------------------------------------------
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=your_langsmith_api_key_here
LANGCHAIN_PROJECT=sovereign-supply-chain-mas
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com

# ------------------------------------------------------------------------------
# 5. State / Sovereign Reserve Thresholds
# ------------------------------------------------------------------------------
STRATEGIC_RESERVE_THRESHOLD=500
MAX_EMERGENCY_BUDGET_EUR=100000
